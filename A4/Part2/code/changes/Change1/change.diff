+/**
+ * Validates every condition in handleAllConditions
+ */
+type ConditionEvaluator = (
+	$editMode: boolean,
+	$states: HassEntities,
+	section: Section,
+	condition: Condition
+) => boolean;
+
+const CONDITION_EVALUATORS: Record<string, ConditionEvaluator> = {
+	and: (em, st, sec, cond) => handleAnd(em, st, sec, cond),
+	or: (em, st, sec, cond) => handleOr(em, st, sec, cond),
+	not: (em, st, sec, cond) => handleNot(em, st, sec, cond),
+	state: (_em, st, _sec, cond) => handleState(st, cond),
+	numeric_state: (_em, st, _sec, cond) => handleNumericState(st, cond),
+	screen: (em, _st, sec, cond) => handleScreen(em, sec, cond)
+};
+
 /**
  * Validates every condition in handleAllConditions
  */
@@ -73,20 +92,9 @@ export function validateCondition(
 	section: Section,
 	condition: Condition
 ): boolean {
-	switch (condition?.condition) {
-		case 'and':
-			return handleAnd($editMode, $states, section, condition);
-		case 'or':
-			return handleOr($editMode, $states, section, condition);
-		case 'state':
-			return handleState($states, condition);
-		case 'numeric_state':
-			return handleNumericState($states, condition);
-		case 'screen':
-			return handleScreen($editMode, section, condition);
-		default:
-			return false;
-	}
+	if (!condition?.condition) return false;
+	const evaluator = CONDITION_EVALUATORS[condition.condition];
+	return evaluator ? evaluator($editMode, $states, section, condition) : false;
 }
 
 /**
@@ -162,6 +170,24 @@ export function handleOr(
 	);
 }
 
+/**
+ * Not
+ */
+export function handleNot(
+	$editMode: boolean,
+	$states: HassEntities,
+	section: Section,
+	condition: Condition
+) {
+	if (!condition.conditions?.length) return false;
+
+	return (
+		!condition.conditions.some((subCondition) =>
+			validateCondition($editMode, $states, section, subCondition)
+		) ?? false
+	);
+}
+
 /**
  * Screen
  */
