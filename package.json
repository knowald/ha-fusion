	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --compiler-warnings \"a11y_autofocus:ignore,a11y_click_events_have_key_events:ignore,a11y_consider_explicit_label:ignore,a11y_no_noninteractive_tabindex:ignore,a11y_no_static_element_interactions:ignore\"",
		"check:boundaries": "node scripts/check-boundaries.mjs",
		"check:bundle": "node scripts/check-bundle-budget.mjs",
		"check:hearth-a11y": "node scripts/check-hearth-a11y.mjs",
		"check:watch": "npm run check -- --watch",
		"test": "vitest run --coverage",
		"test:e2e": "playwright test",
		"lint": "prettier --check . && eslint . --max-warnings 119",
		"format": "prettier --write .",
		"matrix": "playwright test --config playwright.matrix.config.ts",
		"style:inventory": "node scripts/style-inventory.mjs",
		"check:style": "node scripts/check-style-tokens.mjs"
	},
